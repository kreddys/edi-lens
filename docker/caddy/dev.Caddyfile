# FILE: docker/caddy/dev.Caddyfile

{
    # Disable automatic HTTPS for local development
    auto_https off
}

# Main Application & Proxies (Listens on :3001)
:3001 {
    # Route API calls to the backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Route metrics endpoint to the backend
    handle /metrics {
        reverse_proxy backend:8000
    }

    # Route OpenAPI spec and docs to the backend
    handle /openapi.json {
        reverse_proxy backend:8000
    }

    handle /docs* {
        reverse_proxy backend:8000
    }

    handle /redoc* {
        reverse_proxy backend:8000
    }

    # Route MinIO Console requests from the main URL
    handle /minio/* {
        reverse_proxy minio:9001
    }

    # Handle all other traffic as the React UI
    handle {
        reverse_proxy frontend:3000
    }
}

# Keycloak Admin UI (Listens on :8081)
:8081 {
    reverse_proxy keycloak:8080 {
        # Standard proxy headers for external access
        header_up X-Forwarded-Host localhost:8081
        header_up X-Forwarded-Proto http
        header_up X-Forwarded-Port 8081
    }
}

# MinIO Web Console (Standalone Port, Listens on :9001)
:9001 {
    reverse_proxy minio:9001
}

# SFTPGo Web Admin UI & API (Listens on :8082)
:8082 {
    reverse_proxy sftpgo:8080
}

# Apache NiFi (Listens on :8080)
:8080 {
    reverse_proxy https://nifi:8443 {
        transport http {
            tls_insecure_skip_verify
        }
        # Standard forwarded headers
        header_up Host {host}
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote}
        
        # NiFi-specific proxy headers (as per NiFi Admin Guide)
        header_up X-ProxyScheme "http"
        header_up X-ProxyHost "localhost:8080"
        header_up X-ProxyPort "8080"
        header_up X-ProxyContextPath ""
        
        # Rewrite redirects from internal URLs to external ones
        header_down Location "keycloak:8080" "localhost:8081"
        header_down Location "caddy:8081" "localhost:8081"
        header_down Location "nifi:8443" "localhost:8080"
    }
}

# Apache NiFi Registry (Listens on :18080)
:18080 {
    reverse_proxy nifi-registry:18080
}

# Grafana (Listens on :3030)
:3030 {
    reverse_proxy grafana:3000
}

# Prometheus (Listens on :9090)
:9090 {
    reverse_proxy prometheus:9090
}

# Loki (Listens on :3100)
:3100 {
    reverse_proxy loki:3100
}