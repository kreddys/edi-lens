# FILE: docker/caddy/dev.Caddyfile

{
    # Disable automatic HTTPS for local development
    auto_https off
}

# Main Application & Proxies (Listens on :3001)
:3001 {
    # Route API calls to the backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Route MinIO Console requests from the main URL
    handle /minio/* {
        reverse_proxy minio:9001
    }

    # Handle all other traffic as the React UI
    handle {
        reverse_proxy admin-ui:3000
    }
}

# Keycloak Admin UI (Listens on :8081)
:8081 {
    reverse_proxy keycloak:8080
}

# MinIO Web Console (Standalone Port, Listens on :9001)
:9001 {
    reverse_proxy minio:9001
}

# SFTPGo Web Admin UI & API (Listens on :8082)
:8082 {
    reverse_proxy sftpgo:8080
}