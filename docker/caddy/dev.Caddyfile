# FILE: docker/caddy/dev.Caddyfile

{
    # Disable automatic HTTPS for local development
    auto_https off
}

# Main Application & Proxies
# Caddy listens on port 3001 inside the container for these services.
:3001 {
    # Route API calls to the backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Route MinIO Console requests from the main URL
    handle /minio/* {
        reverse_proxy minio:9001
    }

    # Handle all other traffic as the React UI
    handle {
        reverse_proxy admin-ui:3000
    }
}

# Keycloak Admin UI
# Caddy listens on port 8081 inside the container.
:8081 {
    reverse_proxy keycloak:8080
}

# MinIO Web Console (Standalone Port)
# Caddy listens on port 9001 inside the container.
:9001 {
    # --- THIS IS THE FIX ---
    # The MinIO Web UI is served on port 9001, not 9000.
    reverse_proxy minio:9001
    # --- END OF FIX ---
}