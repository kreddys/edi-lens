# FILE: docker/caddy/dev.Caddyfile
# This configuration file is for the LOCAL development environment.

{
    auto_https off
}

# --- Main Application ---
# Mapped to http://localhost:3001
http://localhost:3001 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy admin-ui:3000
    }
}

# --- Keycloak Admin UI ---
# Mapped to http://localhost:8081
http://localhost:8081 {
    reverse_proxy keycloak:8080
}

# --- REMOVED OpenLIT and LightRAG Blocks ---