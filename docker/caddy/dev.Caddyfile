# FILE: docker/dev.Caddyfile
# This configuration file is for the LOCAL development environment.

{
    auto_https off
}

# --- Main Application ---
# Mapped to http://localhost:3000
http://localhost:3000 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy admin-ui:3000
    }
}

# --- Keycloak Admin UI ---
# Mapped to http://localhost:8080
http://localhost:8080 {
    reverse_proxy keycloak:8080
}

# --- OpenLIT Observability UI ---
# Mapped to http://localhost:3300
http://localhost:3300 {
    reverse_proxy openlit-ui:3000
}

# --- LightRAG UI & API ---
# Mapped to http://localhost:3400
http://localhost:3400 {
    reverse_proxy lightrag-server:9621
}