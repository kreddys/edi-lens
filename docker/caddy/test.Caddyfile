# FILE: docker/caddy/test.Caddyfile
# This configuration file is for the ISOLATED TEST environment.
# Note: All ports and service names are specific to the test stack.

{
    auto_https off
}

# --- Test Main Application ---
# Mapped to http://localhost:3001
http://localhost:3001 {
    handle /api/* {
        reverse_proxy backend-test:8000
    }
    handle {
        reverse_proxy admin-ui-test:3000
    }
}

# --- Test Keycloak Admin UI ---
# Mapped to http://localhost:8081
http://localhost:8081 {
    reverse_proxy keycloak-test:8080
}

# --- Test OpenLIT Observability UI ---
# Mapped to http://localhost:3301
http://localhost:3301 {
    reverse_proxy openlit-ui-test:3000
}

# --- Test LightRAG UI & API ---
# Mapped to http://localhost:3401
http://localhost:3401 {
    reverse_proxy lightrag-server-test:9621
}