# FILE: docker/Caddyfile.local
# This configuration file is for the LOCAL development environment.
# It makes Caddy the single entry point for all services on localhost.

{
    # Disable HTTPS for local development to avoid certificate trust issues.
    # We will serve everything over HTTP.
    auto_https off
}

# The main entry point for the application.
# We will use port 3000 to avoid conflicts with other common services.
http://localhost:3000 {

    # Route API calls to the backend service.
    # The 'handle_path' directive strips the /api prefix before forwarding.
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Route all other requests to the Vite development server (admin-ui).
    # This automatically supports Hot Module Replacement (HMR).
    handle {
        reverse_proxy admin-ui:3000
    }
}

# For convenience, we can also proxy Keycloak.
# This is optional but keeps all services under the localhost umbrella.
http://localhost:8080 {
    reverse_proxy keycloak:8080
}