# Dockerfile for NiFi EDI Processors Extension
# Extends the base NiFi image with EDI processing capabilities

FROM apache/nifi:2.5.0

# Switch to root to install packages and set up extensions
USER root

# Install Python and pip first
RUN apt-get update && \
    apt-get install -y python3 python3-pip python3-venv && \
    ln -s /usr/bin/python3 /usr/bin/python && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies for EDI processors (bypass environment restrictions)
RUN python3 -m pip install --break-system-packages --no-cache-dir \
    pydantic>=2.0.0 \
    typing-extensions>=4.0.0

# Create directory for Python extensions and copy processors to root level
RUN mkdir -p /opt/nifi/nifi-current/python_extensions

# Copy individual processor files directly to extensions root
COPY nifi-edi-processors/processors/*.py /opt/nifi/nifi-current/python_extensions/

# Copy supporting modules to extensions directory
COPY nifi-edi-processors/edi_common /opt/nifi/nifi-current/python_extensions/edi_common
COPY nifi-edi-processors/schemas /opt/nifi/nifi-current/python_extensions/schemas

# Set proper permissions for Python extensions
RUN chown -R nifi:nifi /opt/nifi/nifi-current/python_extensions && \
    chmod -R 755 /opt/nifi/nifi-current/python_extensions

# Set NiFi Python path to include extensions directory
ENV PYTHONPATH="/opt/nifi/nifi-current/python_extensions:${PYTHONPATH}"

# Copy OIDC configuration file and set proper permissions
COPY docker/nifi-processors/login-identity-providers.xml /opt/nifi/nifi-current/conf/login-identity-providers.xml
RUN chown nifi:nifi /opt/nifi/nifi-current/conf/login-identity-providers.xml && \
    chmod 664 /opt/nifi/nifi-current/conf/login-identity-providers.xml

# Copy and set up the entrypoint script
COPY docker/nifi-processors/entrypoint.sh /opt/nifi/nifi-current/bin/entrypoint.sh
RUN chmod +x /opt/nifi/nifi-current/bin/entrypoint.sh

# Switch back to nifi user
USER nifi

# Set the entrypoint
ENTRYPOINT ["/opt/nifi/nifi-current/bin/entrypoint.sh"]

# Add labels for identification
LABEL version="1.0.0" \
      description="NiFi with EDI Processors Extension" \
      maintainer="EDI Lens Team"