# This is the configuration for LOCAL development.
# Copy this to .env.local and do not commit it.

# --- Localhost URLs ---
REMOTE_HOST=localhost

# --- PostgreSQL Configuration ---
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=your_super_secret_password
POSTGRES_DB=edi_lens
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- Backend API Configuration ---
LOG_LEVEL=DEBUG
BACKEND_HOST=backend
EDI_SCHEMA_DIRECTORY=/var/edi_lens/schemas

# --- Keycloak Configuration ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=${POSTGRES_DB}
KEYCLOAK_DB_USER=${POSTGRES_USER}
KEYCLOAK_DB_PASSWORD=${POSTGRES_PASSWORD}
KEYCLOAK_DB_SCHEMA=keycloak

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://${REMOTE_HOST}:8080
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui
# This tells Keycloak which origins can embed it in an iframe.
# We need to allow our Vite dev server on port 3001.
KC_SPI_FRAME_ANCESTORS="'self' http://${REMOTE_HOST}:3001"

# --- Admin UI / Vite Configuration ---
VITE_API_URL=http://${REMOTE_HOST}:8000/api/v1
VITE_KEYCLOAK_URL=${KEYCLOAK_BROWSER_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_UI_CLIENT_ID}