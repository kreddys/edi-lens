# ===================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ===================================================================
# Copy this file to .env.local and fill in the secret values.
# This file should NOT be committed to version control.

REMOTE_HOST=localhost

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# --- DB #1: Main Application & RAG Knowledge Base ---
# This single database instance hosts both the core application data and the LightRAG knowledge base.
# It MUST run the custom image with pgvector and Apache AGE extensions.
POSTGRES_HOST=db-app
POSTGRES_PORT=5432
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=a_strong_app_password

# --- FIX: Define BOTH variable names for the database name ---
# The backend application looks for 'POSTGRES_DB'.
# The LightRAG library looks for 'POSTGRES_DATABASE'.
# We define both and set them to the same value to satisfy both services.
POSTGRES_DB=edi_lens_db
POSTGRES_DATABASE=${POSTGRES_DB}

# --- DB #2: Keycloak ---
# A dedicated, standard PostgreSQL database exclusively for Keycloak's data.
POSTGRES_KC_HOST=db-keycloak
POSTGRES_KC_PORT=5433
POSTGRES_KC_USER=keycloak_user
POSTGRES_KC_PASSWORD=a_strong_kc_password
POSTGRES_KC_DB=keycloak_db

# ===================================================================
# BACKEND API CONFIGURATION
# ===================================================================
# Configures the main Python/FastAPI backend service.
# It connects to the main application database (db-app).
LOG_LEVEL=DEBUG
BACKEND_HOST=backend
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas
# Note: The backend's config.py uses POSTGRES_SERVER, which we alias to the correct host.
POSTGRES_SERVER=${POSTGRES_HOST}

# ===================================================================
# KEYCLOAK AUTHENTICATION SERVER CONFIGURATION
# ===================================================================
# Configures the Keycloak service. It connects to its own dedicated database (db-keycloak).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=${POSTGRES_KC_HOST}
KEYCLOAK_DB_DATABASE=${POSTGRES_KC_DB}
KEYCLOAK_DB_USER=${POSTGRES_KC_USER}
KEYCLOAK_DB_PASSWORD=${POSTGRES_KC_PASSWORD}
KEYCLOAK_DB_SCHEMA=public
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://localhost:8080
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# ===================================================================
# LIGHTRAG (RAG ENGINE) SERVER CONFIGURATION
# ===================================================================
# LightRAG automatically uses the top-level POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD,
# and POSTGRES_DATABASE variables from the environment.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# --- LLM & Embedding Bindings for LightRAG Ingestion ---
# Configures the models LightRAG uses internally for document processing.
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=${OPENAI_API_KEY}

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=${OPENAI_API_KEY}

# ===================================================================
# AGENT LLM CONFIGURATION (for the main backend)
# ===================================================================
# The model used by our CrewAI agents for reasoning tasks.
LLM_AGENT_MODEL="anthropic/claude-3-sonnet-20240229"

# --- API Keys ---
# Provide API keys for the LLM/Embedding services you plan to use.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
OPENROUTER_API_KEY="sk-or-v1-..."
GROQ_API_KEY="gsk_..."

# ===================================================================
# OBSERVABILITY & DEBUGGING
# ===================================================================
ENABLE_OBSERVABILITY=true
CREWAI_DISABLE_TELEMETRY=true

# --- OpenLIT Configuration ---
OTEL_EXPORTER_OTLP_ENDPOINT="http://openlit-otel-collector:4318"
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=OPENLIT
OPENLIT_DB_NAME=openlit

# --- Agent/LLM Debugging ---
# Set to 'true' to enable verbose logging from CrewAI and raw LLM I/O from LiteLLM.
AGENT_VERBOSE=false