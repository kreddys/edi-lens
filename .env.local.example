# This is the configuration for LOCAL development.
# Copy this to .env.local and do not commit it.

REMOTE_HOST=localhost

# --- PostgreSQL Configuration ---
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=your_super_secret_password
POSTGRES_DB=edi_lens
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- Backend API Configuration ---
LOG_LEVEL=DEBUG
BACKEND_HOST=backend
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas

# --- Keycloak Configuration ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=${POSTGRES_DB}
KEYCLOAK_DB_USER=${POSTGRES_USER}
KEYCLOAK_DB_PASSWORD=${POSTGRES_PASSWORD}
KEYCLOAK_DB_SCHEMA=keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://localhost:8080
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# --- LLM Configuration using LiteLLM ---
# The model string determines the provider. See https://docs.litellm.ai/docs/providers
# Examples:
#   'openrouter/deepseek/deepseek-chat'
#   'openai/gpt-4o'
#   'anthropic/claude-3-sonnet-20240229'
#   'ollama/llama3'
LLM_MODEL="openrouter/deepseek/deepseek-chat"

# --- API Keys ---
# LiteLLM will automatically find and use the correct key based on the model string.
# You only need to provide the keys for the services you plan to use.
OPENROUTER_API_KEY="sk-or-v1-..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
# For local models via Ollama
OLLAMA_BASE_URL="http://localhost:11434"