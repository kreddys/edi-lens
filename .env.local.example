# FILE: .env.local.example

# This is the configuration for LOCAL development.
# Copy this to .env.local and do not commit it.

REMOTE_HOST=localhost

# --- PostgreSQL Configuration (For Main App & LightRAG) ---
# This single database will now host both the core application data (in the 'public' schema)
# and the LightRAG knowledge base (in the 'edi_lens_kb' schema, managed by the workspace).
# It MUST run the custom image with pgvector and Apache AGE extensions.
POSTGRES_APP_HOST=db-app
POSTGRES_APP_PORT=5432
POSTGRES_APP_USER=edi_user
POSTGRES_APP_PASSWORD=a_strong_app_password
POSTGRES_APP_DB=edi_lens_db

# --- PostgreSQL Configuration (For Keycloak) ---
# This database uses the CONVENTIONAL 'postgres' user.
# This aligns with the default connection behavior of many third-party tools, including Keycloak's internal scripts.
POSTGRES_KC_HOST=db-keycloak
POSTGRES_KC_PORT=5433
POSTGRES_KC_USER=keycloak_user
POSTGRES_KC_PASSWORD=a_very_strong_kc_password
POSTGRES_KC_DB=keycloak_db

# --- Backend API Configuration ---
# The backend points to the shared App/RAG database.
LOG_LEVEL=DEBUG
BACKEND_HOST=backend
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas
POSTGRES_USER=${POSTGRES_APP_USER}
POSTGRES_PASSWORD=${POSTGRES_APP_PASSWORD}
POSTGRES_DB=${POSTGRES_APP_DB}
POSTGRES_SERVER=${POSTGRES_APP_HOST}
POSTGRES_PORT=${POSTGRES_APP_PORT}

# --- Keycloak Configuration ---
# Keycloak is configured to use its own dedicated database.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=${POSTGRES_KC_HOST}
KEYCLOAK_DB_PORT=${POSTGRES_KC_PORT}
KEYCLOAK_DB_DATABASE=${POSTGRES_KC_DB}
KEYCLOAK_DB_USER=${POSTGRES_KC_USER}
KEYCLOAK_DB_PASSWORD=${POSTGRES_KC_PASSWORD}
KEYCLOAK_DB_SCHEMA=public
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://localhost:8080
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# --- LightRAG Server & RAG Agent Configuration ---
# LightRAG now points to the SAME database as the main application.
# The 'workspace' parameter will ensure its tables are logically separated.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
POSTGRES_HOST=${POSTGRES_APP_HOST}
POSTGRES_USERNAME=${POSTGRES_APP_USER}
POSTGRES_PASSWORD=${POSTGRES_APP_PASSWORD}
POSTGRES_DATABASE=${POSTGRES_APP_DB}

# --- LLM & Embedding Bindings for LightRAG Ingestion ---
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=${OPENAI_API_KEY}

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=${OPENAI_API_KEY}

# --- Main Agent Model Configuration ---
LLM_AGENT_MODEL="anthropic/claude-3-sonnet-20240229"

# --- API Keys ---
OPENROUTER_API_KEY="sk-or-v1-..."
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GROQ_API_KEY="gsk_..."

# --- Observability & Other Settings ---
# ... (rest of file is unchanged)