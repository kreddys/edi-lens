# =============================================================================
# EDI LENS - ISOLATED TEST ENVIRONMENT CONFIGURATION
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to `.env.test`.
# 2. The test environment is designed to be self-contained and ephemeral.
#    You typically do not need to change these values.
#
# =============================================================================

# -----------------------------------------------------------------------------
# GLOBAL & DATABASE SETTINGS
# -----------------------------------------------------------------------------
REMOTE_HOST=localhost
# Suffix for Docker service/volume names. Leave empty for the default dev env.
ENV_SUFFIX=-test

# --- DB #1: Test App & RAG DB ---
# Uses a different service name and database name for complete isolation.
POSTGRES_HOST=db-app-test
POSTGRES_DB=edi_lens_db_test
POSTGRES_DATABASE=${POSTGRES_DB}
# Credentials can be the same as dev, as they are on a private Docker network.
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=a_strong_app_password
POSTGRES_PORT=5432

# --- DB #2: Test Keycloak DB ---
POSTGRES_KC_HOST=db-keycloak-test
POSTGRES_KC_DB=keycloak_db_test
POSTGRES_KC_USER=keycloak_user
POSTGRES_KC_PASSWORD=a_strong_kc_password
POSTGRES_KC_PORT=5432

# -----------------------------------------------------------------------------
# KEYCLOAK (TEST INSTANCE)
# -----------------------------------------------------------------------------
# Points to the dedicated test Keycloak container and uses a different browser port.
KEYCLOAK_URL=http://keycloak-test:8080
KEYCLOAK_BROWSER_URL=http://localhost:8081

# Other Keycloak settings remain the same for realm setup.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password
KEYCLOAK_DATABASE_HOST=${POSTGRES_KC_HOST}
KEYCLOAK_DATABASE_PORT=${POSTGRES_KC_PORT}
KEYCLOAK_DATABASE_NAME=${POSTGRES_KC_DB}
KEYCLOAK_DATABASE_USER=${POSTGRES_KC_USER}
KEYCLOAK_DATABASE_PASSWORD=${POSTGRES_KC_PASSWORD}
KEYCLOAK_DATABASE_SCHEMA=public
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# -----------------------------------------------------------------------------
# LIGHTRAG (TEST INSTANCE)
# -----------------------------------------------------------------------------
# Uses a different workspace to isolate RAG data within the test database.
LIGHTRAG_WORKSPACE=edi_lens_kb_test

# --- Copy the rest of the variables from .env.dev.example ---
# They are needed by the containers, even if not directly by the script.
LOG_LEVEL=DEBUG
BACKEND_HOST=backend-test
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas
POSTGRES_SERVER=${POSTGRES_HOST}
VITE_API_URL=http://localhost:3001/api/v1
VITE_KEYCLOAK_URL=${KEYCLOAK_BROWSER_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_UI_CLIENT_ID}
LLM_AGENT_MODEL="anthropic/claude-3-sonnet-20240229"
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
OPENROUTER_API_KEY="sk-or-v1-..."
GROQ_API_KEY="gsk_..."
SERPER_API_KEY="your_serper_dev_api_key_here"
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=${OPENAI_API_KEY}
EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=${OPENAI_API_KEY}
CREWAI_DISABLE_TELEMETRY=true
# Test environment uses different OTEL collector service name
ENABLE_OBSERVABILITY=true
OTEL_EXPORTER_OTLP_ENDPOINT="http://openlit-otel-collector-test:4318"
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=OPENLIT
OPENLIT_DB_NAME=openlit
AGENT_VERBOSE=true