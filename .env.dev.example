# =============================================================================
# EDI LENS - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env.dev` in the project root.
# 2. Fill in the secret values (passwords, API keys) in your new `.env.dev` file.
# 3. The `.env.dev` file is ignored by Git and should NEVER be committed.
#
# =============================================================================


# -----------------------------------------------------------------------------
# GLOBAL ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Defines the public-facing hostname. For local development, this must be 'localhost'.
# For production, this would be your domain (e.g., 'edi-lens.yourcompany.com').
REMOTE_HOST=localhost
# Suffix for Docker service/volume names. Leave empty for the default dev env.
ENV_SUFFIX=


# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# This local setup uses two separate PostgreSQL database containers for isolation.

# --- DB #1: Main Application & RAG Knowledge Base ---
# A custom PostgreSQL instance with pgvector and Apache AGE extensions.
# Used by: Backend API, LightRAG Server.
POSTGRES_HOST=db-app
POSTGRES_PORT=5432
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=a_strong_app_password
POSTGRES_DB=edi_lens_db
POSTGRES_DATABASE=${POSTGRES_DB} # Alias required by the LightRAG library.

# --- DB #2: Keycloak ---
# A standard, dedicated PostgreSQL instance used exclusively by Keycloak.
# Used by: Keycloak Server.
POSTGRES_KC_HOST=db-keycloak
POSTGRES_KC_PORT=5432 # Port is internal to Docker, can be the same as db-app
POSTGRES_KC_USER=keycloak_user
POSTGRES_KC_PASSWORD=a_strong_kc_password
POSTGRES_KC_DB=keycloak_db


# -----------------------------------------------------------------------------
# BACKEND API CONFIGURATION (FastAPI)
# -----------------------------------------------------------------------------
# Configures the main Python/FastAPI service.
LOG_LEVEL=DEBUG
BACKEND_HOST=backend # The service name within the Docker network.
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas # Path inside the backend container.
POSTGRES_SERVER=${POSTGRES_HOST} # Alias required by the backend's config.py.


# -----------------------------------------------------------------------------
# KEYCLOAK AUTHENTICATION SERVER CONFIGURATION (Bitnami Image)
# -----------------------------------------------------------------------------

# --- Admin Credentials ---
# Used by the Bitnami container on first startup and by the realm setup script.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Sample User Passwords ---
# These are used ONLY by the `setup:keycloak` script to create sample users.
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password

# --- Database Connection ---
# These variables tell the Keycloak container how to connect to its dedicated database (db-keycloak).
KEYCLOAK_DATABASE_VENDOR=postgresql
KEYCLOAK_DATABASE_HOST=${POSTGRES_KC_HOST}
KEYCLOAK_DATABASE_PORT=${POSTGRES_KC_PORT}
KEYCLOAK_DATABASE_NAME=${POSTGRES_KC_DB}
KEYCLOAK_DATABASE_USER=${POSTGRES_KC_USER}
KEYCLOAK_DATABASE_PASSWORD=${POSTGRES_KC_PASSWORD}
KEYCLOAK_DATABASE_SCHEMA=public

# --- URLs, Realm & Clients ---
# Used by the backend, UI, and setup script to interact with Keycloak.
KEYCLOAK_URL=http://keycloak:8080            # Internal URL for service-to-service communication.
KEYCLOAK_BROWSER_URL=http://localhost:8080   # Public URL for user browsers (via Caddy proxy).
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui


# -----------------------------------------------------------------------------
# FRONTEND UI CONFIGURATION (Vite / React)
# -----------------------------------------------------------------------------
# These variables are injected into the React application at build time.
# NOTE: All URLs point to the Caddy reverse proxy, not the services directly.
VITE_API_URL=http://localhost:3000/api/v1
VITE_KEYCLOAK_URL=${KEYCLOAK_BROWSER_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_UI_CLIENT_ID}

# -----------------------------------------------------------------------------
# AGENT & LLM CONFIGURATION (Backend CrewAI)
# -----------------------------------------------------------------------------
# The model used by the backend's CrewAI agents for reasoning tasks.
LLM_AGENT_MODEL="anthropic/claude-3-sonnet-20240229"

# --- API Keys ---
# Provide API keys for the LLM/Embedding services you plan to use.
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
OPENROUTER_API_KEY="sk-or-v1-..."
GROQ_API_KEY="gsk_..."


# -----------------------------------------------------------------------------
# LIGHTRAG (RAG ENGINE) CONFIGURATION
# -----------------------------------------------------------------------------
# LightRAG automatically uses the top-level POSTGRES_* variables to connect to db-app.
LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# --- LLM & Embedding Bindings for RAG Ingestion ---
# Configures the models LightRAG uses internally for document processing.
LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_API_KEY=${OPENAI_API_KEY}

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=${OPENAI_API_KEY}


# -----------------------------------------------------------------------------
# OBSERVABILITY & DEBUGGING
# -----------------------------------------------------------------------------
CREWAI_DISABLE_TELEMETRY=true
ENABLE_OBSERVABILITY=true

# --- OpenLIT Configuration ---
# Used by the observability containers and the backend/lightrag services.
OTEL_EXPORTER_OTLP_ENDPOINT="http://openlit-otel-collector:4318"
OPENLIT_DB_USER=default
OPENLIT_DB_PASSWORD=OPENLIT
OPENLIT_DB_NAME=openlit

# --- Agent/LLM Debugging ---
# Set to 'true' to enable verbose logging from CrewAI and raw LLM I/O from LiteLLM.
AGENT_VERBOSE=false