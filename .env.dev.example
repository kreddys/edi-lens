# =============================================================================
# EDI LENS - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env.dev` in the project root.
# 2. Fill in the secret values (passwords, API keys) in your new `.env.dev` file.
# 3. The `.env.dev` file is ignored by Git and should NEVER be committed.
#
# =============================================================================

# -----------------------------------------------------------------------------
# GLOBAL ENVIRONMENT SETTINGS
# -----------------------------------------------------------------------------
# Defines the public-facing hostname. For local development, this must be 'localhost'.
# For production, this would be your domain (e.g., 'edi-lens.yourcompany.com').
REMOTE_HOST=localhost

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# This local setup uses two separate PostgreSQL database containers for isolation.

# --- DB #1: Main Application DB ---
# A custom PostgreSQL instance with pgvector and Apache AGE extensions.
# Used by: Backend API.
POSTGRES_HOST=db-app
POSTGRES_PORT=5432
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=a_strong_app_password
POSTGRES_DB=edi_lens

POSTGRES_SFTPGO_USER=sftpgo_user
POSTGRES_SFTPGO_PASSWORD=a_strong_sftpgo_password
POSTGRES_SFTPGO_DB=sftpgo

# --- DB #2: Keycloak ---
# A standard, dedicated PostgreSQL instance used exclusively by Keycloak.
# Used by: Keycloak Server.
POSTGRES_KC_HOST=db-keycloak
POSTGRES_KC_PORT=5432 # Port is internal to Docker, can be the same as db-app
POSTGRES_KC_USER=keycloak_user
POSTGRES_KC_PASSWORD=a_strong_kc_password
POSTGRES_KC_DB=keycloak_db

# -----------------------------------------------------------------------------
# BACKEND API CONFIGURATION (FastAPI)
# -----------------------------------------------------------------------------
# Configures the main Python/FastAPI service.
LOG_LEVEL=INFO
# The `POSTGRES_SERVER` alias is required by the backend's config.py.
POSTGRES_SERVER=${POSTGRES_HOST}
EDI_SCHEMA_DIRECTORY=/home/appuser/app/data/edi_schemas # Path inside the backend container.

# -----------------------------------------------------------------------------
# KEYCLOAK AUTHENTICATION SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# --- Admin Credentials ---
# Used by the Keycloak container on first startup and by the realm setup script.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Sample User Passwords ---
# These are used ONLY by the `setup:keycloak` script to create sample users.
KC_SUPERUSER_PASSWORD=password
KC_ADMIN_A_PASSWORD=password
KC_VIEWER_B_PASSWORD=password

# --- URLs, Realm & Client Configuration ---
# Used by the backend, UI, scripts, and setup script to interact with Keycloak.
KEYCLOAK_URL=http://keycloak:8080            # Internal URL for service-to-service communication.
KEYCLOAK_BROWSER_URL=http://localhost:8081   # Public URL for user browsers (via Caddy proxy).
KEYCLOAK_REALM=edi-lens

# --- Main Application Clients ---
# Backend API service client (for internal API authentication)
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it

# Frontend UI client (public client for user authentication)
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# --- NEW: OFFICIAL KEYCLOAK QUARKUS VARS ---
# These variables are used by the official Keycloak container to configure itself.
KC_DB=postgres
KC_DB_URL_HOST=${POSTGRES_KC_HOST}
KC_DB_URL_PORT=${POSTGRES_KC_PORT}
KC_DB_URL_DATABASE=${POSTGRES_KC_DB}
KC_DB_USERNAME=${POSTGRES_KC_USER}
KC_DB_PASSWORD=${POSTGRES_KC_PASSWORD}
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false
KC_HOSTNAME_STRICT_HTTPS=false
KC_PROXY=edge
KC_HOSTNAME=${REMOTE_HOST}
KC_HOSTNAME_PORT=8081

# --- Service Account Clients ---
# These clients are used for service-to-service authentication and automated workflows.

# NiFi Service Account - Used by Apache NiFi processors for EDI workflow automation
KEYCLOAK_NIFI_CLIENT_ID=nifi-service
KEYCLOAK_NIFI_CLIENT_SECRET=nifi-service-secret

# SFTPGo Client - Used for OIDC SSO authentication with the SFTPGo admin interface
KEYCLOAK_SFTPGO_CLIENT_ID=sftpgo
KEYCLOAK_SFTPGO_CLIENT_SECRET=a_very_secure_sftpgo_secret_change_it

# -----------------------------------------------------------------------------
# FRONTEND UI CONFIGURATION (Vite / React)
# -----------------------------------------------------------------------------
# These variables are injected into the React application at build time.
# NOTE: All URLs point to the Caddy reverse proxy, not the services directly.
VITE_API_URL=http://localhost:3001/api/v1
VITE_KEYCLOAK_URL=${KEYCLOAK_BROWSER_URL}
VITE_KEYCLOAK_REALM=${KEYCLOAK_REALM}
VITE_KEYCLOAK_CLIENT_ID=${KEYCLOAK_UI_CLIENT_ID}

# -----------------------------------------------------------------------------
# OBJECT STORAGE CONFIGURATION (S3-Compatible, e.g., MinIO or AWS S3)
# -----------------------------------------------------------------------------
# Generic S3-compatible credentials. For MinIO, these are the root user/pass.
# For AWS, these would be IAM credentials.
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_BUCKET=edi-lens
STORAGE_REGION=us-east-1 # Optional for MinIO, required for AWS S3

# -----------------------------------------------------------------------------
# SFTP SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Credentials used by the backend service to connect to the SFTPGo Admin API
# to automatically create trading partner users and configure event webhooks.
SFTPGO_ADMIN_USER=admin
SFTPGO_ADMIN_PASSWORD=admin123

# --- SFTP Event Configuration ---
# SFTPGo API endpoint for event configuration
SFTPGO_API_URL=http://sftpgo:8080/api/v2

# Backend webhook URL for real-time file processing
BACKEND_WEBHOOK_URL=http://backend:8000/api/v1/sftp/hooks/upload

#--------------------------------------------------------------------------
# NiFi Registry Database Settings
#--------------------------------------------------------------------------
POSTGRES_NIFI_REGISTRY_DB=nifi_registry
POSTGRES_NIFI_REGISTRY_USER=nifi_registry
POSTGRES_NIFI_REGISTRY_PASSWORD=nifi_registry_password

#--------------------------------------------------------------------------
# NiFi Settings
#--------------------------------------------------------------------------
# NiFi Service URLs (for backend integration)
NIFI_URL=http://nifi:8080
NIFI_REGISTRY_URL=http://nifi-registry:18080
NIFI_AUTH_TOKEN=
NIFI_REGISTRY_AUTH_TOKEN=

# NiFi Administration
NIFI_ADMIN_USER=admin
NIFI_ADMIN_PASSWORD=admin123
NIFI_SENSITIVE_PROPS_KEY=nifi-sensitive-props-key-change-this-in-production
NIFI_JVM_HEAP_INIT=1g
NIFI_JVM_HEAP_MAX=2g
