# This is an example environment file.
# Copy this to .env and fill in your own values. DO NOT COMMIT .env.

# --- PostgreSQL Configuration ---
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=your_super_secret_password
POSTGRES_DB=edi_lens
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- Backend API Configuration ---
LOG_LEVEL=DEBUG
BACKEND_HOST=backend
EDI_SCHEMA_DIRECTORY=/var/edi_lens/schemas

# --- Keycloak Configuration ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak DB settings now point to the main app DB, but with a specific schema.
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=${POSTGRES_DB}
KEYCLOAK_DB_USER=${POSTGRES_USER}
KEYCLOAK_DB_PASSWORD=${POSTGRES_PASSWORD}
KEYCLOAK_DB_SCHEMA=keycloak

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://localhost:8080
KEYCLOAK_REALM=edi-lens
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# --- Admin UI / Vite Configuration ---
VITE_API_URL=http://localhost:8000/api/v1