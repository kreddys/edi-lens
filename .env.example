# This is an example environment file.
# Copy this to .env and fill in your own values. DO NOT COMMIT .env.

# --- PostgreSQL Configuration ---
# Used by both the backend and Keycloak containers.
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=your_super_secret_password
POSTGRES_DB=edi_lens
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# --- Backend API Configuration ---
# Log level for the backend application (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG
# The hostname of the backend service within the Docker network
BACKEND_HOST=backend
# The directory inside the container where EDI schemas are stored.
# This path is mounted to a persistent Docker volume.
EDI_SCHEMA_DIRECTORY=/var/edi_lens/schemas

# --- Keycloak Configuration ---
# Admin credentials for the master Keycloak realm (for initial setup)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Database for Keycloak to use within the PostgreSQL instance
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=edi_user
KEYCLOAK_DB_PASSWORD=edi_password

# The URL where Keycloak is running
KEYCLOAK_URL=http://keycloak:8080
# The public-facing URL for browser redirects
KEYCLOAK_BROWSER_URL=http://localhost:8080
# The name of the application realm
KEYCLOAK_REALM=edi-lens
# The confidential client ID for the backend service
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
# The secret for the backend client (should be a strong, random string)
KEYCLOAK_BACKEND_CLIENT_SECRET=this-is-a-very-secret-key-change-it
# The public client ID for the UI service
KEYCLOAK_UI_CLIENT_ID=edi-lens-ui

# --- Admin UI / Vite Configuration ---
VITE_API_URL=http://localhost:8000/api/v1