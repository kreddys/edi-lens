# ==============================================================================
# EDI Lens Environment Configuration Template
# ==============================================================================
# This file serves as the master template for all environment configurations.
# Copy this file to create your environment-specific configurations:
#   - .env        -> For Docker container internal networking
#   - .env.local  -> For local development (services in Docker, client on host)
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL database settings for both the main application and NiFi Registry

# Database credentials and connection info
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=edi_lens
POSTGRES_MULTIPLE_DATABASES=nifi_registry

# Backend database connection URL
# Format: postgresql+asyncpg://user:password@host:port/database
# For local development: use localhost:5432
# For Docker containers: use db:5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edi_lens

# ==============================================================================
# NIFI CONFIGURATION
# ==============================================================================
# Apache NiFi settings for the workflow engine

# NiFi API connection settings
# For local development: use https://localhost:8443
# For Docker containers: use https://nifi:8443
NIFI_URL=https://localhost:8443

# NiFi authentication credentials
# Username and password for NiFi single-user authentication
NIFI_USERNAME=admin
NIFI_PASSWORD=adminadmin123

# NiFi security and performance settings
# Encryption key for sensitive properties (change for production!)
NIFI_SENSITIVE_PROPS_KEY=change-this-key-for-production
# JVM heap memory allocation
NIFI_JVM_HEAP_INIT=1g
NIFI_JVM_HEAP_MAX=2g

# NiFi Docker container settings
# HTTPS configuration
NIFI_WEB_HTTPS_PORT=8443
NIFI_WEB_HTTPS_HOST=0.0.0.0

# ==============================================================================
# NIFI REGISTRY CONFIGURATION
# ==============================================================================
# Apache NiFi Registry settings for flow version control

# Registry API connection settings
# For local development: use http://localhost:18080
# For Docker containers: use http://nifi-registry:18080
NIFI_REGISTRY_URL=http://localhost:18080

# Registry authentication (optional)
NIFI_REGISTRY_AUTH_TOKEN=

# Registry Docker container settings
NIFI_REGISTRY_WEB_HTTP_HOST=0.0.0.0
NIFI_REGISTRY_WEB_HTTP_PORT=18080

# Registry database connection (for Docker container)
NIFI_REGISTRY_DB_URL=jdbc:postgresql://db:5432/nifi_registry
NIFI_REGISTRY_DB_USER=postgres
NIFI_REGISTRY_DB_PASS=postgres
NIFI_REGISTRY_DB_CLASS=org.postgresql.Driver
NIFI_REGISTRY_DB_DRIVER_CLASS=org.postgresql.Driver
NIFI_REGISTRY_DB_DRIVER_DIRECTORY=/opt/nifi-registry/nifi-registry-current/lib

# ==============================================================================
# BACKEND APPLICATION CONFIGURATION
# ==============================================================================
# EDI Lens backend API settings

# Application metadata
APP_VERSION=0.1.0

# Development and debugging
# Set to true for development, false for production
DEBUG=true

# SSL/TLS verification settings
# Set to false for development with self-signed certificates
# Set to true for production with valid certificates
NIFI_VERIFY_SSL=false
REGISTRY_VERIFY_SSL=false

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
# Optional logging level overrides for different components
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Leave commented to use defaults

# LOG_LEVEL_CONSOLE=INFO      # Console output log level
# LOG_LEVEL_FILE=DEBUG        # File output log level
# LOG_LEVEL_CLIENTS=INFO      # NiFi/Registry client log level
# LOG_LEVEL_SERVICES=INFO     # Business logic services log level
# LOG_LEVEL_API=INFO          # FastAPI application log level

# ==============================================================================
# DOCKER COMPOSE OVERRIDES
# ==============================================================================
# These variables are used by Docker Compose but may be overridden in
# environment-specific files (.env, .env.local)

# Legacy SSL setting (deprecated, use NIFI_VERIFY_SSL and REGISTRY_VERIFY_SSL)
VERIFY_SSL=false
