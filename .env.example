# PostgreSQL Database Configuration
POSTGRES_USER=edi_user
POSTGRES_PASSWORD=edi_password
POSTGRES_DB=edi_lens
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Backend Application Settings
API_V1_STR=/api/v1
SECRET_KEY=your_super_secret_key_here

# --- Keycloak Database Configuration ---
# For local setup, these can point to the same server/user as the main app DB.
# For production, they could point to a different server entirely.
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=edi_user
KEYCLOAK_DB_PASSWORD=edi_password

# Keycloak Configuration for Backend
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_BROWSER_URL=http://localhost:8080
KEYCLOAK_REALM=edi-lens

KEYCLOAK_UI_CLIENT_ID=edi-lens-ui
KEYCLOAK_BACKEND_CLIENT_ID=edi-lens-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=a_client_secret_that_is_long_and_secure

# Keycloak Admin Credentials (for initial setup)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

LOG_LEVEL=INFO